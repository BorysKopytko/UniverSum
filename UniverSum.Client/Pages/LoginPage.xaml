<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:UniverSum.Client.ViewModels"
             x:Class="UniverSum.Client.Pages.LoginPage"
             Title="Вхід">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PageBackgroundColor">#FFFFFF</Color>
            <Color x:Key="TextColor">#000000</Color>
            <Color x:Key="ButtonBackgroundColor">#0078D4</Color>
            <Color x:Key="ButtonTextColor">#FFFFFF</Color>
            <Color x:Key="EntryBackgroundColor">#F0F0F0</Color>
            <Color x:Key="EntryTextColor">#000000</Color>
            <Color x:Key="PageBackgroundColor">#1E1E1E</Color>
            <Color x:Key="TextColor">#FFFFFF</Color>
            <Color x:Key="ButtonBackgroundColor">#0078D4</Color>
            <Color x:Key="ButtonTextColor">#FFFFFF</Color>
            <Color x:Key="EntryBackgroundColor">#3A3A3A</Color>
            <Color x:Key="EntryTextColor">#FFFFFF</Color>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.BindingContext>
        <viewModels:LoginViewModel />
    </ContentPage.BindingContext>
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20" BackgroundColor="{DynamicResource PageBackgroundColor}">
            <Entry Text="{Binding Email}"
                   Placeholder="Введіть електронну пошту"
                   TextColor="{DynamicResource EntryTextColor}"
                   BackgroundColor="{DynamicResource EntryBackgroundColor}"
                   Margin="0,0,0,10"
                   HorizontalOptions="FillAndExpand" />
            <Entry Text="{Binding Password}"
                   Placeholder="Введіть пароль"
                   IsPassword="True"
                   TextColor="{DynamicResource EntryTextColor}"
                   BackgroundColor="{DynamicResource EntryBackgroundColor}"
                   Margin="0,0,0,20"
                   HorizontalOptions="FillAndExpand" />
            <Button Text="Увійти"
                    Command="{Binding LoginCommand}"
                    BackgroundColor="{DynamicResource ButtonBackgroundColor}"
                    TextColor="{DynamicResource ButtonTextColor}"
                    Padding="10"
                    HorizontalOptions="FillAndExpand"
                    CornerRadius="5" />
            <Button Text="Зареєструватись"
                    Command="{Binding RegisterCommand}"
                    BackgroundColor="{DynamicResource ButtonBackgroundColor}"
                    TextColor="{DynamicResource ButtonTextColor}"
                    Padding="10"
                    HorizontalOptions="FillAndExpand"
                    CornerRadius="5" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
    