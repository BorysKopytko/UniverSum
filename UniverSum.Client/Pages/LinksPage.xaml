<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UniverSum.Client.Pages.LinksPage"
             xmlns:viewModels="clr-namespace:UniverSum.Client.ViewModels" 
             Title="Посилання">
    <ContentPage.BindingContext>
        <viewModels:LinksViewModel />
    </ContentPage.BindingContext>
    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PageBackgroundColor">#FFFFFF</Color>
            <Color x:Key="ItemBackgroundColor">#F0F0F0</Color>
            <Color x:Key="TextColor">#000000</Color>
            <Color x:Key="LinkColor">#1E90FF</Color>
            <Color x:Key="DarkPageBackgroundColor">#121212</Color>
            <Color x:Key="DarkItemBackgroundColor">#333333</Color>
            <Color x:Key="DarkTextColor">#FFFFFF</Color>
            <Color x:Key="DarkLinkColor">#4DA6FF</Color>
            <Style x:Key="LinkItemStyle" TargetType="Border">
                <Setter Property="Padding" Value="10"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="BackgroundColor" Value="{DynamicResource ItemBackgroundColor}"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>
            <Style x:Key="LinkLabelStyle" TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource TextColor}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="LineBreakMode" Value="WordWrap"/>
            </Style>
            <Style x:Key="LinkDescriptionStyle" TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource TextColor}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="LineBreakMode" Value="WordWrap"/>
            </Style>
            <Style x:Key="LinkStyle" TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource LinkColor}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="TextDecorations" Value="Underline"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ScrollView>
        <CollectionView ItemsSource="{Binding Items}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource LinkItemStyle}">
                        <StackLayout Padding="10">
                            <Image Source="{Binding LogoPath}" Style="{StaticResource LinkLabelStyle}"/>
                            <Label Text="{Binding Title}" Style="{StaticResource LinkLabelStyle}"/>
                            <Label Text="{Binding Description}" Style="{StaticResource LinkDescriptionStyle}"/>
                            <Label Text="{Binding Url}" Style="{StaticResource LinkStyle}" 
                                   GestureRecognizers="{Binding Url, Converter={StaticResource UrlTapGestureConverter}}"/>
                        </StackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </ScrollView>
</ContentPage>
    