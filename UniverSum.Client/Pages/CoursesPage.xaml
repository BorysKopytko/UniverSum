<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UniverSum.Client.Pages.CoursesPage"
             xmlns:viewModels="clr-namespace:UniverSum.Client.ViewModels" 
             Title="Курси">
    <ContentPage.BindingContext>
        <viewModels:CoursesViewModel />
    </ContentPage.BindingContext>
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="CourseTitleStyle" TargetType="Label">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" />
            </Style>
            <Style x:Key="CourseDescriptionStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#555555, Dark=#CCCCCC}" />
            </Style>
            <Style x:Key="CourseBorderStyle" TargetType="Border">
                <Setter Property="Stroke" Value="{AppThemeBinding Light=#CCCCCC, Dark=#444444}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#333333}" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="Margin" Value="10" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ScrollView>
        <CollectionView ItemsSource="{Binding Items}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CourseBorderStyle}">
                        <VerticalStackLayout>
                            <Label Text="{Binding Title}" Style="{StaticResource CourseTitleStyle}" />
                            <Label Text="{Binding Description}" Style="{StaticResource CourseDescriptionStyle}" />
                            <Button Text="Детальніше" Command="{Binding DetailsCommand}" CommandParameter="{Binding Id}"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </ScrollView>
</ContentPage>
