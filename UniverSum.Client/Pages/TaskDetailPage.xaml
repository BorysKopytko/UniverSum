<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UniverSum.Client.Pages.TaskDetailPage"
             xmlns:viewModels="clr-namespace:UniverSum.Client.ViewModels"
             Title="Деталі завдання">
    <ContentPage.BindingContext>
        <viewModels:TaskDetailViewModel />
    </ContentPage.BindingContext>
    <ContentPage.Resources>
        <Style x:Key="DetailLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="Medium" />
            <Setter Property="Margin" Value="0,5,0,5" />
        </Style>
        <Style x:Key="HeaderLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="Large" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="0,10,0,10" />
        </Style>
        <Style x:Key="NoteEditorStyle" TargetType="Editor">
            <Setter Property="FontSize" Value="Medium" />
            <Setter Property="HeightRequest" Value="100" />
            <Setter Property="Margin" Value="0,10,0,10" />
        </Style>
    </ContentPage.Resources>
    <ScrollView>
        <StackLayout Padding="20" Spacing="10">
            <Label Text="{Binding Item.Title}" Style="{StaticResource HeaderLabelStyle}" />
            <Label Text="Курс/Тема:" Style="{StaticResource DetailLabelStyle}" />
            <Label Text="{Binding Item.Course}" Style="{StaticResource DetailLabelStyle}" />
            <Label Text="Термін:" Style="{StaticResource DetailLabelStyle}" />
            <Label Text="{Binding Item.EndDateTime, StringFormat='До: {0:yyyy-MM-dd}'}" Style="{StaticResource DetailLabelStyle}" />
            <Label Text="Пріоритет:" Style="{StaticResource DetailLabelStyle}" />
            <Label Text="{Binding Item.Priority}" Style="{StaticResource DetailLabelStyle}" />
            <Label Text="Оцінка:" Style="{StaticResource HeaderLabelStyle}" IsVisible="{Binding IsStudent}" />
            <Label Text="{Binding Item.MaxMark}" Style="{StaticResource DetailLabelStyle}" IsVisible="{Binding IsStudent}" />
            <Label Text="Примітки:" Style="{StaticResource HeaderLabelStyle}" />
            <Editor Text="{Binding Item.Messages}" Style="{StaticResource NoteEditorStyle}" />
        </StackLayout>
    </ScrollView>
</ContentPage>